<Application x:Class="TopBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BarBackground" Color="#1E1E2E" Opacity="0.85" />
        <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4" />
        <SolidColorBrush x:Key="TextMuted" Color="#7F849C" />
        <SolidColorBrush x:Key="Accent" Color="#89B4FA" />
    </Application.Resources>
</Application>
