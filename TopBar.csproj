<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 suffix is what unlocks WinRT projections (Windows.Media.Control)
         with zero extra NuGet packages -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TopBar</AssemblyName>
    <RootNamespace>TopBar</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!-- Ship as a single self-contained exe: no .NET runtime install required on
         the machine that runs it, and no separate DLLs scattered around it -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- .NET SDK bug (dotnet/sdk#37608): when both UseWPF and UseWindowsForms are true,
       ImplicitUsings silently injects both frameworks' namespaces as GLOBAL usings,
       so any type name both frameworks define (Application, Color, Rectangle,
       KeyEventArgs, MessageBox, OpenFileDialog, ...) becomes ambiguous everywhere in
       the project. We only use WinForms for the tray icon, and that code already
       fully-qualifies or aliases every WinForms type, so removing these two implicit
       usings has no downside and eliminates this whole class of error at the source. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
