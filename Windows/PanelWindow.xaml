<Window x:Class="TopBar.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TopBar.Converters"
        Title="TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="800" Height="470"
        Visibility="Hidden"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <conv:PercentToWidthMultiConverter x:Key="PercentToWidthConverter" />

        <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A6ADC8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="20" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A" />
                                <Setter Property="Foreground" Value="#CDD6F4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2B3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon buttons: prev/next/shuffle/repeat/play -->
        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#2A2B3D" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="19" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363752" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#89B4FA" />
            <Setter Property="Foreground" Value="#1B1B29" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="26" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A5C6FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#749EE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleIconButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B90A8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244" />
                                <Setter Property="Foreground" Value="#89B4FA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2B3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#232435" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2A2B3D" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder" CornerRadius="26" Padding="20" Background="#1B1B29" BorderThickness="1" BorderBrush="#2E2F45"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="36" ShadowDepth="10" Direction="270" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanelTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#232435" CornerRadius="22" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="TabDashboard" Content="Dashboard" IsChecked="True"
                                      Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Dashboard" />
                        <ToggleButton x:Name="TabMedia" Content="Media"
                                      Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Media" />
                    </StackPanel>
                </Border>

                <!-- ===================== DASHBOARD ===================== -->
                <Grid x:Name="DashboardPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Weather -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherIconText" FontSize="26" Text="⛅" />
                            <TextBlock x:Name="WeatherTempText" FontSize="26" FontWeight="SemiBold"
                                       Foreground="#CDD6F4" Margin="0,4,0,0" Text="--°" />
                            <TextBlock x:Name="WeatherDescText" FontSize="12" Foreground="#8B90A8" Text="--" />
                        </StackPanel>
                    </Border>

                    <!-- Profile / uptime -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#2A2B3D">
                                <Image x:Name="PfpImage" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileNameText" FontSize="15" FontWeight="SemiBold" Foreground="#CDD6F4" Text="--" />
                                <TextBlock x:Name="UptimeText" FontSize="12" Foreground="#8B90A8" Margin="0,3,0,0" Text="up --" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Media (lite) -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                        <StackPanel>
                            <Border Width="90" Height="90" CornerRadius="14" Background="#2A2B3D" HorizontalAlignment="Center">
                                <Image x:Name="LiteAlbumImage" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Name="LiteTitleText" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" Text="No media" />
                            <TextBlock x:Name="LiteArtistText" FontSize="11" Foreground="#8B90A8"
                                       HorizontalAlignment="Center" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" Text="" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" Style="{StaticResource RoundIconButton}" Width="30" Height="30" Margin="0,0,6,0" Click="OnPrevClick" />
                                <Button x:Name="LitePlayButton" Content="▶" Style="{StaticResource RoundIconButton}" Width="30" Height="30" Margin="0,0,6,0" Click="OnPlayPauseClick" />
                                <Button Content="⏭" Style="{StaticResource RoundIconButton}" Width="30" Height="30" Click="OnNextClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clock / date -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ClockText" FontSize="36" FontWeight="SemiBold"
                                       Foreground="#CDD6F4" HorizontalAlignment="Center" Text="--:--" />
                            <TextBlock x:Name="AmPmText" FontSize="13" Foreground="#8B90A8" HorizontalAlignment="Center" Text="--" />
                            <TextBlock x:Name="DateText" FontSize="12" Foreground="#8B90A8"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" Text="--" />
                        </StackPanel>
                    </Border>

                    <!-- Calendar -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="‹" Click="OnCalendarPrev"
                                        Style="{StaticResource RoundIconButton}" Width="26" Height="26" FontSize="13" />
                                <TextBlock x:Name="CalendarMonthText" Grid.Column="1" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#CDD6F4" Text="--" />
                                <Button Grid.Column="2" Content="›" Click="OnCalendarNext"
                                        Style="{StaticResource RoundIconButton}" Width="26" Height="26" FontSize="13" />
                            </Grid>

                            <UniformGrid x:Name="CalendarWeekdayHeader" Grid.Row="1" Columns="7" Margin="0,0,0,4" />
                            <UniformGrid x:Name="CalendarDaysGrid" Grid.Row="2" Columns="7" Rows="6" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== MEDIA ===================== -->
                <Grid x:Name="MediaTabPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Album art + visualizer ring + controls -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Grid x:Name="VisualizerHost" Width="220" Height="220" HorizontalAlignment="Center">
                            <Canvas x:Name="VisualizerCanvas" Width="220" Height="220" />
                            <Border Width="150" Height="150" CornerRadius="24" Background="#2A2B3D"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                <Image x:Name="AlbumImage" Stretch="UniformToFill" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="MediaTitleText" FontSize="17" FontWeight="SemiBold" Foreground="#CDD6F4"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" Text="Nothing playing" />
                        <TextBlock x:Name="MediaArtistText" FontSize="12" Foreground="#8B90A8"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="" />
                        <TextBlock x:Name="MediaAlbumText" FontSize="11" Foreground="#5C6079"
                                   HorizontalAlignment="Center" Margin="0,1,0,10" TextTrimming="CharacterEllipsis" Text="" />

                        <Grid Margin="4,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" Grid.Column="0" FontSize="10" Foreground="#8B90A8" Text="0:00" />
                            <Border x:Name="ProgressTrack" Grid.Column="1" Height="4" CornerRadius="2" Background="#313244"
                                    Margin="8,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="ProgressFillBar" CornerRadius="2" Background="#89B4FA"
                                        HorizontalAlignment="Left" Width="0" />
                            </Border>
                            <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10" Foreground="#8B90A8" Text="0:00" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton x:Name="ShuffleButton" Content="🔀" Style="{StaticResource ToggleIconButton}" Margin="0,0,8,0" Click="OnShuffleClick" />
                            <Button Content="⏮" Style="{StaticResource RoundIconButton}" Margin="0,0,8,0" Click="OnPrevClick" />
                            <Button x:Name="PlayPauseButton" Content="▶" Style="{StaticResource PlayButton}" Margin="0,0,8,0" Click="OnPlayPauseClick" />
                            <Button Content="⏭" Style="{StaticResource RoundIconButton}" Margin="0,0,8,0" Click="OnNextClick" />
                            <ToggleButton x:Name="RepeatButton" Content="🔁" Style="{StaticResource ToggleIconButton}" Click="OnRepeatClick" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Lyrics -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Lyrics" FontWeight="SemiBold" FontSize="14"
                                       Foreground="#CDD6F4" Margin="2,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LyricsText" TextWrapping="Wrap" Foreground="#A6ADC8"
                                           FontSize="13" LineHeight="21" Text="" />
                            </ScrollViewer>

                            <Border x:Name="SpotifyBadge" Grid.Row="2" Background="#1DB95422" CornerRadius="14"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="Spotify" FontSize="11" FontWeight="SemiBold" Foreground="#1DB954" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
