<Window x:Class="TopBar.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="420" Height="480"
        Visibility="Hidden"
        FontFamily="Segoe UI"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7F849C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244" />
                                <Setter Property="Foreground" Value="#CDD6F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="14" Padding="16" Background="#1E1E2E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tab strip -->
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                <ToggleButton x:Name="TabDashboard" Content="Dashboard" IsChecked="True"
                              Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Dashboard" />
                <ToggleButton x:Name="TabMedia" Content="Media"
                              Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Media" />
                <ToggleButton x:Name="TabPerformance" Content="Performance"
                              Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Performance" />
                <ToggleButton x:Name="TabWeather" Content="Weather"
                              Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Weather" />
            </StackPanel>

            <!-- ===== Dashboard ===== -->
            <Grid x:Name="DashboardPanel" Grid.Row="1">
                <StackPanel VerticalAlignment="Top">
                    <Border x:Name="PfpBorder" Width="72" Height="72" CornerRadius="36"
                            Background="#313244" HorizontalAlignment="Center" Margin="0,4,0,12">
                        <Image x:Name="PfpImage" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock x:Name="ClockText" FontSize="34" FontWeight="SemiBold"
                               Foreground="#CDD6F4" HorizontalAlignment="Center" Text="--:--:--" />
                    <TextBlock x:Name="DateText" FontSize="14" Foreground="#7F849C"
                               HorizontalAlignment="Center" Margin="0,4,0,0" Text="--" />
                </StackPanel>
            </Grid>

            <!-- ===== Media ===== -->
            <Grid x:Name="MediaPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="MediaTitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="#CDD6F4" TextTrimming="CharacterEllipsis" Text="Nothing playing" />
                    <TextBlock x:Name="MediaArtistText" FontSize="13" Foreground="#7F849C"
                               TextTrimming="CharacterEllipsis" Text="" />
                </StackPanel>

                <!-- Lyrics side panel — only populated when the active session is Spotify -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LyricsText" TextWrapping="Wrap" Foreground="#CDD6F4"
                               FontSize="13" LineHeight="20" Text="" />
                </ScrollViewer>
            </Grid>

            <!-- ===== Performance ===== -->
            <StackPanel x:Name="PerformancePanel" Grid.Row="1" Visibility="Collapsed">
                <TextBlock Text="CPU" Foreground="#7F849C" FontSize="12" Margin="0,4,0,2" />
                <ProgressBar x:Name="CpuBar" Height="10" Minimum="0" Maximum="100"
                             Foreground="#89B4FA" Background="#313244" BorderThickness="0" />
                <TextBlock x:Name="CpuLabel" Foreground="#CDD6F4" FontSize="12" Margin="0,2,0,10" Text="0%" />

                <TextBlock Text="RAM" Foreground="#7F849C" FontSize="12" Margin="0,4,0,2" />
                <ProgressBar x:Name="RamBar" Height="10" Minimum="0" Maximum="100"
                             Foreground="#89B4FA" Background="#313244" BorderThickness="0" />
                <TextBlock x:Name="RamLabel" Foreground="#CDD6F4" FontSize="12" Margin="0,2,0,10" Text="0%" />

                <TextBlock Text="Disk" Foreground="#7F849C" FontSize="12" Margin="0,4,0,2" />
                <ProgressBar x:Name="DiskBar" Height="10" Minimum="0" Maximum="100"
                             Foreground="#89B4FA" Background="#313244" BorderThickness="0" />
                <TextBlock x:Name="DiskLabel" Foreground="#CDD6F4" FontSize="12" Margin="0,2,0,10" Text="0%" />

                <TextBlock Text="Network" Foreground="#7F849C" FontSize="12" Margin="0,4,0,2" />
                <TextBlock x:Name="NetworkLabel" Foreground="#CDD6F4" FontSize="12" Text="↓ 0 KB/s  ↑ 0 KB/s" />
            </StackPanel>

            <!-- ===== Weather ===== -->
            <StackPanel x:Name="WeatherPanel" Grid.Row="1" Visibility="Collapsed">
                <TextBlock x:Name="WeatherLocationText" FontSize="14" Foreground="#7F849C" Text="--" />
                <TextBlock x:Name="WeatherTempText" FontSize="40" FontWeight="SemiBold"
                           Foreground="#CDD6F4" Margin="0,8,0,0" Text="--°" />
                <TextBlock x:Name="WeatherDescText" FontSize="14" Foreground="#7F849C" Text="--" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
