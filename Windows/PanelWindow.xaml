<Window x:Class="TopBar.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="800" Height="470"
        Visibility="Hidden"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
        Deactivated="OnDeactivated">

    <Grid>
        <Border x:Name="RootBorder" CornerRadius="{DynamicResource ThemePanelRadius}" Padding="20"
                Background="{DynamicResource ThemeSurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="36" ShadowDepth="10" Direction="270" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanelTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab strip spans the full width, split evenly; a settings gear sits beside it -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#232435" CornerRadius="20" Padding="4">
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="TabDashboard" Content="Dashboard" IsChecked="True"
                                          Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Dashboard" />
                            <ToggleButton x:Name="TabMedia" Content="Media"
                                          Style="{StaticResource TabButtonStyle}" Click="OnTabClick" Tag="Media" />
                        </UniformGrid>
                    </Border>
                    <Button Grid.Column="1" Content="&#xE713;" Style="{StaticResource RoundIconButton}"
                            Margin="10,0,0,0" Click="OnSettingsClick" ToolTip="Settings" />
                </Grid>

                <!-- ===================== DASHBOARD ===================== -->
                <Grid x:Name="DashboardPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="132" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Weather -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherIconText" FontSize="22" Foreground="#CDD6F4" Text="⛅︎" />
                            <TextBlock x:Name="WeatherTempText" FontSize="24" FontWeight="SemiBold"
                                       Foreground="#CDD6F4" Margin="0,6,0,0" Text="--°" />
                            <TextBlock x:Name="WeatherDescText" FontSize="11.5" Foreground="#8B90A8" Margin="0,2,0,0" Text="--" />
                        </StackPanel>
                    </Border>

                    <!-- Profile / uptime -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ThemeElevatedBrush}">
                                <Image x:Name="PfpImage" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileNameText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" Text="--" />
                                <TextBlock x:Name="UptimeText" FontSize="12.5" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,4,0,0" Text="up --" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Media (lite) -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="MEDIA" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeFaintTextBrush}" Margin="0,0,0,12" />
                            <Grid Width="112" Height="112" HorizontalAlignment="Center">
                                <Polygon Points="22,0 90,0 112,22 112,90 90,112 22,112 0,90 0,22" Fill="{DynamicResource ThemeElevatedBrush}" />
                                <Polygon Points="22,0 90,0 112,22 112,90 90,112 22,112 0,90 0,22">
                                    <Polygon.Fill>
                                        <ImageBrush x:Name="LiteAlbumBrush" Stretch="UniformToFill" />
                                    </Polygon.Fill>
                                </Polygon>
                            </Grid>
                            <TextBlock x:Name="LiteTitleText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" Text="No media" />
                            <TextBlock x:Name="LiteArtistText" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" Text="" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="&#xE892;" Style="{StaticResource RoundIconButton}" Width="30" Height="30" FontSize="10" Margin="0,0,6,0" Click="OnPrevClick" />
                                <Button x:Name="LitePlayButton" Content="&#xE768;" Style="{StaticResource RoundIconButton}" Width="30" Height="30" FontSize="10" Margin="0,0,6,0" Click="OnPlayPauseClick" />
                                <Button Content="&#xE893;" Style="{StaticResource RoundIconButton}" Width="30" Height="30" FontSize="10" Click="OnNextClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clock / date — compact stacked format: WED / 10:13 / PM / SEP 2 -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="WeekdayText" Style="{StaticResource CaptionLabel}" Text="---" />
                            <TextBlock x:Name="ClockText" FontSize="32" FontWeight="SemiBold"
                                       Foreground="#CDD6F4" HorizontalAlignment="Center" Margin="0,4,0,0" Text="--:--" />
                            <TextBlock x:Name="AmPmText" FontSize="12" Foreground="#8B90A8" HorizontalAlignment="Center" Margin="0,2,0,8" Text="--" />
                            <TextBlock x:Name="DateText" Style="{StaticResource CaptionLabel}" Text="---" />
                        </StackPanel>
                    </Border>

                    <!-- Calendar -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="&#xE76B;" Click="OnCalendarPrev"
                                        Style="{StaticResource RoundIconButton}" Width="26" Height="26" FontSize="10" />
                                <TextBlock x:Name="CalendarMonthText" Grid.Column="1" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#CDD6F4" Text="--" />
                                <Button Grid.Column="2" Content="&#xE76C;" Click="OnCalendarNext"
                                        Style="{StaticResource RoundIconButton}" Width="26" Height="26" FontSize="10" />
                            </Grid>

                            <UniformGrid x:Name="CalendarWeekdayHeader" Grid.Row="1" Columns="7" Margin="0,0,0,4" />
                            <UniformGrid x:Name="CalendarDaysGrid" Grid.Row="2" Columns="7" Rows="6" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== MEDIA ===================== -->
                <Grid x:Name="MediaTabPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Album art (octagon) + visualizer ring + controls -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Grid x:Name="VisualizerHost" Width="220" Height="220" HorizontalAlignment="Center">
                            <Canvas x:Name="VisualizerCanvas" Width="220" Height="220" />
                            <Grid Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Polygon Points="30,0 120,0 150,30 150,120 120,150 30,150 0,120 0,30" Fill="#2A2B3D" />
                                <Polygon Points="30,0 120,0 150,30 150,120 120,150 30,150 0,120 0,30">
                                    <Polygon.Fill>
                                        <ImageBrush x:Name="AlbumBrush" Stretch="UniformToFill" />
                                    </Polygon.Fill>
                                </Polygon>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="MediaTitleText" FontSize="17" FontWeight="SemiBold" Foreground="#CDD6F4"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" Text="Nothing playing" />
                        <TextBlock x:Name="MediaArtistText" FontSize="12" Foreground="#8B90A8"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="" />
                        <TextBlock x:Name="MediaAlbumText" FontSize="11" Foreground="#5C6079"
                                   HorizontalAlignment="Center" Margin="0,1,0,10" TextTrimming="CharacterEllipsis" Text="" />

                        <Grid Margin="4,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" Grid.Column="0" FontSize="10" Foreground="#8B90A8" Text="0:00" />
                            <Border x:Name="ProgressTrack" Grid.Column="1" Height="4" CornerRadius="2" Background="#313244"
                                    Margin="8,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="ProgressFillBar" CornerRadius="2" Background="#89B4FA"
                                        HorizontalAlignment="Left" Width="0" />
                            </Border>
                            <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10" Foreground="#8B90A8" Text="0:00" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton x:Name="ShuffleButton" Content="&#xE8B1;" Style="{StaticResource ToggleIconButton}" Margin="0,0,8,0" Click="OnShuffleClick" />
                            <Button Content="&#xE892;" Style="{StaticResource RoundIconButton}" Margin="0,0,8,0" Click="OnPrevClick" />
                            <Button x:Name="PlayPauseButton" Content="&#xE768;" Style="{StaticResource PlayButton}" Margin="0,0,8,0" Click="OnPlayPauseClick" />
                            <Button Content="&#xE893;" Style="{StaticResource RoundIconButton}" Margin="0,0,8,0" Click="OnNextClick" />
                            <ToggleButton x:Name="RepeatButton" Content="&#xE8EE;" Style="{StaticResource ToggleIconButton}" Click="OnRepeatClick" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Lyrics -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Lyrics" FontWeight="SemiBold" FontSize="14"
                                       Foreground="#CDD6F4" Margin="2,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LyricsText" TextWrapping="Wrap" Foreground="#A6ADC8"
                                           FontSize="13" LineHeight="21" Text="" />
                            </ScrollViewer>

                            <Border x:Name="SpotifyBadge" Grid.Row="2" Background="#1DB95422" CornerRadius="14"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="Spotify" FontSize="11" FontWeight="SemiBold" Foreground="#1DB954" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
