<Window x:Class="TopBar.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopBar Settings"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
        Foreground="{DynamicResource ThemeTextBrush}">

    <Border x:Name="RootBorder" CornerRadius="{DynamicResource ThemePanelRadius}" Background="{DynamicResource ThemeSurfaceBrush}"
            BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}" Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="36" ShadowDepth="10" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom draggable header, since the window has no native chrome — stays fixed while the rest scrolls -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag" Margin="0,0,0,18">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" />
                <Button Content="✕" Style="{StaticResource FlatIconButton}" FontSize="13"
                        HorizontalAlignment="Right" Click="OnCancel" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
            <StackPanel>

            <!-- Hotkey -->
            <TextBlock Text="HOTKEY" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Alt is fixed. Click the box, then press a key to pair with it."
                               FontSize="11.5" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBox x:Name="HotkeyBox" Text="Alt + Q" IsReadOnly="True" Style="{StaticResource FieldTextBox}"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                    <CheckBox x:Name="AutoStartCheck" Content="Launch TopBar when Windows starts"
                              Style="{StaticResource FieldCheckBox}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Theme — the customization studio -->
            <TextBlock Text="THEME" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <!-- Colors: 2x2 so hex fields have room to breathe -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,10">
                            <TextBlock Text="Background" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="MainColorBox" Style="{StaticResource FieldTextBox}" TextChanged="OnLiveThemeChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,10">
                            <TextBlock Text="Card" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="SecondaryColorBox" Style="{StaticResource FieldTextBox}" TextChanged="OnLiveThemeChanged" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Accent" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="TertiaryColorBox" Style="{StaticResource FieldTextBox}" TextChanged="OnLiveThemeChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Text" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="TextColorBox" Style="{StaticResource FieldTextBox}" TextChanged="OnLiveThemeChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Hex codes, e.g. #1E1E2E" FontSize="10.5" Foreground="{DynamicResource ThemeFaintTextBrush}" Margin="2,0,0,14" />

                    <!-- Shape / elevation -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Corner roundness" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CornerRadiusLabel" Grid.Column="1" FontSize="12" Foreground="{DynamicResource ThemeMutedTextBrush}" Text="20px" />
                    </Grid>
                    <Slider x:Name="CornerRadiusSlider" Minimum="4" Maximum="32" Value="20" Margin="0,4,0,14" FocusVisualStyle="{x:Null}"
                            ValueChanged="OnCornerRadiusChanged" />

                    <CheckBox x:Name="ShadowCheck" Content="Card shadows" Style="{StaticResource FieldCheckBox}"
                              IsChecked="True" Checked="OnLiveThemeChanged" Unchecked="OnLiveThemeChanged" Margin="0,0,0,16" />

                    <!-- Live preview — reflects every edit above instantly, before Save -->
                    <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeFaintTextBrush}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Sample card" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Text="This is what your theme looks like" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE768;" Style="{StaticResource PlayButton}" Width="38" Height="38" FontSize="12" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Profile picture -->
            <TextBlock Text="PROFILE PICTURE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PfpPathBox" Grid.Column="0" IsReadOnly="True" Style="{StaticResource FieldTextBox}" Margin="0,0,10,0" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Click="OnBrowsePfp" />
                </Grid>
            </Border>

            <!-- Media card image — shown on the Dashboard's Media widget when nothing is playing -->
            <TextBlock Text="MEDIA CARD IMAGE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Shown in the Dashboard's Media widget when nothing is playing."
                               FontSize="11.5" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MediaImagePathBox" Grid.Column="0" IsReadOnly="True" Style="{StaticResource FieldTextBox}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Click="OnBrowseMediaImage" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Weather -->
            <TextBlock Text="WEATHER LOCATION" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBox x:Name="WeatherLabelBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Latitude" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="LatBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Longitude" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="LonBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="FahrenheitCheck" Content="Show °F instead of °C" Style="{StaticResource FieldCheckBox}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
