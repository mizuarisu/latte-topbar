<Window x:Class="TopBar.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopBar Settings"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Border CornerRadius="24" Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="#2E2F45" Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="36" ShadowDepth="10" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <!-- Custom draggable header, since the window has no native chrome -->
            <Grid MouseLeftButtonDown="OnHeaderDrag" Margin="0,0,0,18">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="✕" Style="{StaticResource FlatIconButton}" FontSize="13"
                        HorizontalAlignment="Right" Click="OnCancel" />
            </Grid>

            <!-- Hotkey -->
            <TextBlock Text="HOTKEY" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Alt is fixed. Click the box, then press a key to pair with it."
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBox x:Name="HotkeyBox" Text="Alt + Q" IsReadOnly="True" Style="{StaticResource FieldTextBox}"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                    <CheckBox x:Name="AutoStartCheck" Content="Launch TopBar when Windows starts"
                              Style="{StaticResource FieldCheckBox}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Theme -->
            <TextBlock Text="THEME" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Main" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="MainColorBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Secondary" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="SecondaryColorBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Accent" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="TertiaryColorBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Hex codes, e.g. #1E1E2E" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="2,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Profile picture -->
            <TextBlock Text="PROFILE PICTURE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PfpPathBox" Grid.Column="0" IsReadOnly="True" Style="{StaticResource FieldTextBox}" Margin="0,0,10,0" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Click="OnBrowsePfp" />
                </Grid>
            </Border>

            <!-- Weather -->
            <TextBlock Text="WEATHER LOCATION" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBox x:Name="WeatherLabelBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Latitude" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="LatBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Longitude" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="LonBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="FahrenheitCheck" Content="Show °F instead of °C" Style="{StaticResource FieldCheckBox}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Border>
</Window>
